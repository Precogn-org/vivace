# claude-rc-keepalive: "template" unit. The instance (%i) is the session identifier,
# e.g. claude-rc@test-vps-cli.service <-> ~/.config/claude-rc/test-vps-cli.env
#
# This service ONLY checks/relaunches: it finishes within a second (Type=oneshot).
# It is triggered by the claude-rc@.timer timer every minute and at boot.
[Unit]
Description=Claude Code Remote Control: check and relaunch session %i
Documentation=https://code.claude.com/docs/en/remote-control
# Nothing to do if the instance has no configuration file.
ConditionPathExists=%E/claude-rc/%i.env

[Service]
Type=oneshot
ExecStart=%h/.local/lib/claude-rc/claude-rc-ensure %i
# ESSENTIAL: tmux and claude are started BY this script but must outlive it.
# With the default value (control-group), systemd would kill them as soon as the script ends
# (outage observed on 2026-09-24: sessions dead at every timer run).
KillMode=process
# User services do not have ~/.local/bin in their PATH (where `claude` lives).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=120
