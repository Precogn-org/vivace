# claude-rc-keepalive: "template" timer. Activates claude-rc@<id>.service:
#  - 60 s after the machine boots (gives the network time to come up),
#  - then 60 s after the end of each check.
# Without "loginctl enable-linger <user>", the user manager (and therefore this timer)
# only starts at the first login: check with `loginctl show-user $USER -p Linger`.
[Unit]
Description=Every-minute check of Remote Control session %i

[Timer]
OnBootSec=60s
OnUnitInactiveSec=60s
# Default accuracy = 1 min (measured on 25/09: detection after 69 s); it is brought down to 1 s.
AccuracySec=1s
# Spreads launches by at most 30 s when several instances exist (avoids N simultaneous starts at boot).
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
