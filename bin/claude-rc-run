#!/usr/bin/env bash
# claude-rc-run: runs INSIDE tmux. Starts `claude remote-control`: first by resuming the previous session
# (--continue); on failure, the MESSAGE shown decides what happens (the exit code is always 1).
#
# Usage: claude-rc-run <id> [--fresh]     (called by claude-rc-ensure, not by hand)
#   --fresh   does not try --continue: directly creates a new session (explicit request: claude-rc-ctl fresh)
#
# Claude Code 2.1.282 messages (extracted from the binary; see docs/VERIFIED.md) and the decision taken:
#   "Resuming session ..."                            resume under way           -> never a new session
#   "No recent session found in this directory ..."   nothing to resume (first time or > ~4 h)
#                                                        -> RC_FALLBACK=never (default): NOTHING, code 7 (human decision)
#                                                        -> RC_FALLBACK=norecord      : NEW session (the only allowed case)
#   "... has no environment_id ..."                   session never attached     -> NOTHING, code 6 (human decision)
#   "... already being served by another ... instance"  session already served   -> NOTHING, code 5 (duplicate avoided)
#   "Another ... instance ... already running ..."    same (race between two launches) -> NOTHING, code 5
#   any other message (or empty screen)               unknown (network, server...) -> NOTHING, code 6, retry later
# Rules:
#  - claude stays attached to the tmux terminal: never a pipe (| tee), it would exit immediately.
#  - a session that ran for at least RC_CONTINUE_FAIL_SECONDS is never replaced here.
#  - no new session without explicit permission: `claude-rc-ctl fresh <id> --yes`, or RC_FALLBACK=norecord
#    (limited to the single message "No recent session found").
#
# Exit codes: those of claude; 5 = session already served by another instance; 6 = unknown --continue failure;
#             7 = nothing to resume and RC_FALLBACK=never.
set -uo pipefail
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# shellcheck disable=SC1091
. "$HERE/common.sh" 2>/dev/null || . "$HERE/../lib/common.sh"

rc_load_config "${1:-}" || exit $?
fresh_only=0; [ "${2:-}" = "--fresh" ] && fresh_only=1
cd "$RC_DIR" || { rc_log ERROR "working directory not found: $RC_DIR"; exit 1; }

args=(remote-control --name "$RC_NAME" --permission-mode "$RC_PERMISSION_MODE")

# A NEW session asks, the first time in a directory, the interactive question "Spawn mode? [1/2]", which
# would block an unattended start: the mode is therefore given explicitly (same-dir = Claude Code's default).
start_fresh() {
  rc_mark_started
  start=$(rc_mono)
  "$CLAUDE_BIN" "${args[@]}" --spawn same-dir
  rc=$?
  elapsed=$(( $(rc_mono) - start ))
}

if [ "$fresh_only" = 1 ]; then
  rc_log INFO "starting '$RC_NAME' in $RC_DIR: NEW session requested (--fresh)"
  start_fresh
else
  rc_log INFO "starting '$RC_NAME' in $RC_DIR: trying to resume (--continue)"
  rc_mark_started
  start=$(rc_mono)
  "$CLAUDE_BIN" "${args[@]}" --continue
  rc=$?
  elapsed=$(( $(rc_mono) - start ))

  if [ "$rc" -ne 0 ] && [ "$elapsed" -lt "$RC_CONTINUE_FAIL_SECONDS" ]; then
    screen=$(rc_screen)
    last=$(printf '%s\n' "$screen" | grep -v '^[[:space:]]*$' | tail -n 4 | tr '\n' '|' | cut -c1-400)
    case "$screen" in
      *"Resuming session"*)
        rc_log WARN "the resume was under way, then the process stopped (code $rc after ${elapsed}s): no new session. Last lines: $last" ;;
      *"No recent session found"*)
        if [ "$RC_FALLBACK" = norecord ]; then
          if rc_network_ok; then
            rc_log WARN "nothing to resume (code $rc after ${elapsed}s: $last): RC_FALLBACK=norecord -> NEW session '$RC_NAME'. Any previous one will stay offline in claude.ai/code: to be archived."
            start_fresh
          else
            rc_log WARN "nothing to resume but the API is unreachable: no new session, trying again at the next timer run"
          fi
        else
          rc_log ERROR "nothing to resume in $RC_DIR (${last:-<empty screen>}) and RC_FALLBACK=never: NO new session created. To create one deliberately: claude-rc-ctl fresh $RC_ID --yes"
          exit 7
        fi ;;
      *"has no environment_id"*)
        rc_log ERROR "the session to resume was never attached to a server: NO new session created. Message: $last. Human decision: claude-rc-ctl fresh $RC_ID --yes"
        exit 6 ;;
      *"already being served"*|*"already running in this directory"*|*"split-brain"*)
        rc_log ERROR "the session is already being served by another instance: NO new session created. Message: $last"
        exit 5 ;;
      *)
        rc_log ERROR "unknown --continue failure (code $rc after ${elapsed}s): NO new session created. Last lines: ${last:-<empty screen>}. If the session is permanently lost: claude-rc-ctl fresh $RC_ID --yes"
        exit 6 ;;
    esac
  fi
fi

rc_log INFO "process ended (code $rc after ${elapsed}s); the timer will check within a minute"
exit "$rc"
