#!/usr/bin/env bash
# claude-rc-ctl: manual control of the Remote Control sessions managed by claude-rc-keepalive.
#
# Usage: claude-rc-ctl <command> [<id>] [options]
#   list                       all configured sessions: name, directory, timer, process, memory;
#                              also reports DUPLICATES (same name used by several processes, whatever their origin)
#   create <id> --name "Name" --dir /absolute/path [--mode acceptEdits|default|plan] [--fallback never|norecord]
#                              writes ~/.config/claude-rc/<id>.env (600) after validation; starts NOTHING
#   enable <id>                enables the timer (automatic start); requires the session to have started once already
#   disable <id>               disables the timer; the running session is NOT stopped
#   status <id>                full state (manual stop, process, memory, tmux, Claude login, journal)
#   stop <id>                  MANUAL stop: creates the flag and stops the session; the timer will not restart it
#   start <id>                 removes the flag, resets the anti-loop counter and launches (resume with --continue)
#   restart <id>               stops the process WITHOUT a flag, waits for it to exit, relaunches with --continue
#   fresh <id> --yes           creates a NEW session (no --continue): the old one stays offline in claude.ai
#   logs <id> [n]              the last n lines of the journal (default 50)
#   screen <id>                the current screen of the tmux session (read-only)
set -uo pipefail
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# shellcheck disable=SC1091
. "$HERE/common.sh" 2>/dev/null || . "$HERE/../lib/common.sh"

usage() { sed -n '2,/^set -uo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 64; }

# ---------- commands that do not load (or do not yet load) a configuration ----------
do_list() {
  local f id avail
  avail=$(rc_mem_available_mb)
  printf '%-16s %-38s %-9s %-10s %-7s %s\n' ID NAME TIMER PROCESS MEM_MB DIRECTORY
  for f in "$CLAUDE_RC_CONFIG_DIR"/*.env; do
    [ -e "$f" ] || continue
    id=$(basename "$f" .env)
    (
      if ! rc_load_config "$id" 2>/dev/null; then printf '%-16s %s\n' "$id" "(invalid configuration: claude-rc-ctl status $id)"; exit 0; fi
      timer=$(systemctl --user is-enabled "claude-rc@$id.timer" 2>/dev/null | head -1); timer=${timer:-unknown}
      pids=$(rc_server_pids | tr '\n' ' ')
      if [ -n "${pids// /}" ]; then proc="pid ${pids%% *}"; mem=$(( $(rc_tree_rss_kb "${pids%% *}") / 1024 )); else proc="none"; mem="-"; fi
      printf '%-16s %-38.38s %-9s %-10s %-7s %s\n' "$id" "$RC_NAME" "$timer" "$proc" "$mem" "$RC_DIR"
    )
  done
  [ -n "$avail" ] && echo "available memory: ${avail} MB"
  dups=$(rc_duplicate_names)
  if [ -n "$dups" ]; then
    echo
    echo "WARNING - DUPLICATES: several Remote Control processes use the same name (two conversations, doubled memory):"
    printf '%s\n' "$dups" | awk -F'\t' '{ if ($1 != last) { printf "  \"%s\"\n", $1; last = $1 } printf "      pid %-8s %-12s %s\n", $2, $3, $4 }'
    echo "  Keep ONE session per name. The one from claude-rc-keepalive is stopped with: claude-rc-ctl stop <id>"
  fi
  return 0
}

do_create() {   # do_create <id> --name N --dir D [--mode M] [--fallback F]
  local id=$1 name="" dir="" mode=acceptEdits fallback=never f rcx
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --name)     name=${2-}; shift 2 || usage ;;
      --dir)      dir=${2-}; shift 2 || usage ;;
      --mode)     mode=${2-}; shift 2 || usage ;;
      --fallback) fallback=${2-}; shift 2 || usage ;;
      *) echo "unknown option: $1" >&2; usage ;;
    esac
  done
  [ -n "$name" ] && [ -n "$dir" ] || { echo "create: --name and --dir are required" >&2; exit 64; }
  case "$id" in ''|*[!a-z0-9._-]*) echo "invalid identifier: '$id' (lowercase letters, digits, . _ - only)" >&2; exit 64 ;; esac
  f="$CLAUDE_RC_CONFIG_DIR/$id.env"
  [ ! -e "$f" ] || { echo "$f already exists: not overwriting it" >&2; exit 64; }
  ( umask 077; mkdir -p "$CLAUDE_RC_CONFIG_DIR" ) && chmod 700 "$CLAUDE_RC_CONFIG_DIR" 2>/dev/null || true
  (
    umask 077
    {
      echo "# Created by claude-rc-ctl create on $(date -u '+%Y-%m-%dT%H:%M:%SZ'). Shell syntax; no secret here."
      echo "RC_NAME=$(rc_squote "$name")"
      echo "RC_DIR=$(rc_squote "${dir%/}")"
      echo "RC_PERMISSION_MODE=$(rc_squote "$mode")"
      echo "RC_FALLBACK=$(rc_squote "$fallback")"
    } > "$f"
  )
  ( rc_load_config "$id" ); rcx=$?
  if [ "$rcx" -ne 0 ]; then rm -f "$f"; echo "creation cancelled (code $rcx): $id.env not kept" >&2; exit "$rcx"; fi
  mkdir -p -- "$dir" || { rm -f "$f"; echo "cannot create $dir" >&2; exit 1; }
  echo "created: $f"
  echo "  name (claude.ai) : $name"
  echo "  directory        : $dir   (the Claude Code \"trust\" dialog must have been accepted for this directory)"
  echo "Nothing has been started. Next steps:"
  echo "  1. claude-rc-ctl fresh $id --yes     first session, requested explicitly"
  echo "  2. claude-rc-ctl enable $id          automatic start (resume with --continue)"
}

cmd=${1:-}; id=${2:-}
[ -n "$cmd" ] || usage
case "$cmd" in
  list) do_list; exit 0 ;;
  -h|--help|help) usage ;;
esac
[ -n "$id" ] || usage
if [ "$cmd" = create ]; then shift 2; do_create "$id" "$@"; exit 0; fi
rc_load_config "$id" || exit $?

# Stops the server(s) with SIGTERM and WAITS for them to exit (max 20 s): relaunching too early would make
# --continue fail with "already being served" (or, worse, leave two servers).
stop_processes() {
  local pids i
  pids=$(rc_server_pids | tr '\n' ' ')
  # shellcheck disable=SC2086
  [ -n "${pids// /}" ] && kill -TERM $pids 2>/dev/null
  for i in $(seq 1 "$RC_STOP_WAIT"); do
    [ -z "$(rc_server_pids)" ] && break
    sleep 1
  done
  if [ -n "$(rc_server_pids)" ]; then echo "the server is still running after ${RC_STOP_WAIT} s (pid $(rc_server_pids | tr '\n' ' ')): giving up" >&2; return 1; fi
  tmux kill-session -t "$RC_TMUX_SESSION" 2>/dev/null
  return 0
}

case "$cmd" in
  status)
    pids=$(rc_server_pids | tr '\n' ' ')
    echo "identifier         : $RC_ID"
    echo "name (claude.ai)   : $RC_NAME"
    echo "directory          : $RC_DIR"
    echo "permission mode    : $RC_PERMISSION_MODE"
    echo "fallback           : $RC_FALLBACK"
    [ -e "$RC_STOP_FLAG" ] && echo "manual stop        : YES (since $(cat "$RC_STOP_FLAG"))" || echo "manual stop        : no"
    if [ -n "${pids// /}" ]; then
      echo "server process     : running (pid ${pids% })"
      echo "memory (server + children): $(( $(rc_tree_rss_kb "${pids%% *}") / 1024 )) MB"
    else echo "server process     : none"; fi
    conf=$(rc_name_conflicts)
    if [ -n "$conf" ]; then
      echo "DUPLICATE          : another process uses the name '$RC_NAME':"
      printf '%s\n' "$conf" | awk -F'\t' '{ printf "                     pid %s (%s) in %s\n", $1, $2, $3 }'
    fi
    tmux has-session -t "$RC_TMUX_SESSION" 2>/dev/null && echo "tmux session       : $RC_TMUX_SESSION (exists)" || echo "tmux session       : $RC_TMUX_SESSION (absent)"
    RC_AUTH_FRESH=1 rc_auth_ok && echo "Claude login       : OK" || echo "Claude login       : INVALID (redo: claude auth login)"
    n=$(grep -Ec '^[0-9]+$' "$RC_LAUNCHES" 2>/dev/null || true)
    echo "recent launches    : ${n:-0} (pause above $RC_MAX_LAUNCHES per ${RC_LAUNCH_WINDOW}s)"
    avail=$(rc_mem_available_mb); [ -n "$avail" ] && echo "available memory   : ${avail} MB (launch threshold: ${RC_MIN_AVAILABLE_MB} MB)"
    echo "--- journal (last 8 lines)"
    tail -n 8 "$CLAUDE_RC_STATE_DIR/$RC_ID.log" 2>/dev/null || echo "(journal empty)"
    ;;
  enable)
    if [ ! -e "$RC_STARTED" ]; then
      echo "'$RC_ID' has never started yet: create the first session explicitly first:" >&2
      echo "  claude-rc-ctl fresh $RC_ID --yes" >&2
      exit 64
    fi
    systemctl --user enable --now "claude-rc@$RC_ID.timer" || exit 1
    rc_log INFO "timer enabled (claude-rc-ctl enable)"
    echo "timer enabled for '$RC_ID': checks every minute, and at machine boot"
    ;;
  disable)
    systemctl --user disable --now "claude-rc@$RC_ID.timer" || exit 1
    rc_log INFO "timer disabled (claude-rc-ctl disable)"
    echo "timer disabled for '$RC_ID'; the running session is NOT stopped (claude-rc-ctl stop $RC_ID to stop it)"
    ;;
  stop)
    rc_mkstate
    rc_write "$RC_STOP_FLAG" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    rc_log INFO "manual stop requested (claude-rc-ctl stop)"
    stop_processes || exit 1
    echo "stopped. The timer will not relaunch '$RC_ID' until you run: claude-rc-ctl start $RC_ID"
    ;;
  start)
    rm -f "$RC_STOP_FLAG" "$CLAUDE_RC_STATE_DIR/$RC_ID.last"
    ( umask 077; : > "$RC_LAUNCHES" ) 2>/dev/null || true
    rc_log INFO "start requested (claude-rc-ctl start)"
    exec "$HERE/claude-rc-ensure" "$RC_ID"
    ;;
  restart)
    rc_log INFO "restart requested (claude-rc-ctl restart)"
    stop_processes || exit 1
    rm -f "$CLAUDE_RC_STATE_DIR/$RC_ID.last"
    ( umask 077; : > "$RC_LAUNCHES" ) 2>/dev/null || true   # human decision: the anti-loop counter restarts from zero
    exec "$HERE/claude-rc-ensure" "$RC_ID"
    ;;
  fresh)
    if [ "${3:-}" != "--yes" ]; then
      echo "This command creates a NEW claude.ai session \"$RC_NAME\": the old one will stay offline in claude.ai/code (to be archived)." >&2
      echo "Confirm with: claude-rc-ctl fresh $RC_ID --yes" >&2
      exit 64
    fi
    rc_log WARN "NEW session requested (claude-rc-ctl fresh --yes)"
    rm -f "$RC_STOP_FLAG" "$CLAUDE_RC_STATE_DIR/$RC_ID.last"
    stop_processes || exit 1
    ( umask 077; : > "$RC_LAUNCHES" ) 2>/dev/null || true   # human decision: the anti-loop counter restarts from zero
    RC_FORCE_FRESH=1 exec "$HERE/claude-rc-ensure" "$RC_ID"
    ;;
  logs)
    tail -n "${3:-50}" "$CLAUDE_RC_STATE_DIR/$RC_ID.log" 2>/dev/null || echo "(journal empty)"
    ;;
  screen)
    tmux capture-pane -p -t "$RC_TMUX_SESSION" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -30 || echo "(no tmux session)"
    ;;
  *) usage ;;
esac
