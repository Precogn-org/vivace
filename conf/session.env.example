# Example configuration for ONE Remote Control session. The simplest way is to create it with:
#   claude-rc-ctl create <id> --name "Display name" --dir /absolute/path/of/the/directory
# This file is called ~/.config/claude-rc/<id>.env; shell syntax: NAME='value', no space around the "=".
# It must contain NO secret: the Claude login is the one from `claude auth login`.

# Name shown in claude.ai/code and in the mobile app: free text (spaces, accents, "/"...).
RC_NAME='Example session'

# Working directory: ABSOLUTE and DURABLE path, unique to this session (--continue is tied to it).
# Refused: /tmp, /var/tmp, /dev/shm, /run (emptied at boot). Claude Code must have approved this directory once
# (the "trust" dialog).
RC_DIR="$HOME/claude-rc/sessions/example"

# Permission mode. Allowed: default, acceptEdits, plan. (bypassPermissions/auto/dontAsk are refused.)
RC_PERMISSION_MODE='acceptEdits'

# Fallback when --continue answers "No recent session found" (nothing to resume):
#   never    (default) no new session: human decision (claude-rc-ctl fresh <id> --yes)
#   norecord creates a new session, and only in this precise case
RC_FALLBACK='never'

# --- Advanced settings (default values; uncomment to change) ---
# CLAUDE_BIN="$HOME/.local/bin/claude"
# RC_TMUX_SESSION="rc-<id>"
# RC_CONTINUE_FAIL_SECONDS=45     # a --continue failure before this delay is analysed (message read from the screen)
# RC_MAX_LAUNCHES=3               # anti-loop: at most N launches...
# RC_LAUNCH_WINDOW=600            # ...per window of M seconds, then an automatic pause
# RC_MIN_AVAILABLE_MB=1024        # launches nothing if available memory is below this (MB)
# RC_LOG_MAX_BYTES=1048576        # journal rotation (one generation kept)
